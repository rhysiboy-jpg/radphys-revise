<?xml version="1.0" encoding="UTF-8"?>
<!--
  The RadPhys Revise add-in for PowerPoint. This file is what a lecturer gives PowerPoint (Insert > Add-ins > Upload My
  Add-in), or what IT deploys centrally. It only says where the add-in page lives: the page itself is on the live site, so
  updates to the app reach every slide without anyone reinstalling. The README explains installing it.
  Keep the Id the same for ever; raise Version when this file changes.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>d715c8eb-8145-44d7-91a9-0c4aaadd7582</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Rhys Morris</ProviderName>
  <DefaultLocale>en-GB</DefaultLocale>
  <DisplayName DefaultValue="RadPhys Revise diagrams" />
  <Description DefaultValue="Live, interactive diagrams from RadPhys Revise (radiography physics) on a slide. Choose a diagram while editing; in the slide show you can move its sliders and press its buttons. It saves only which diagram the slide shows." />
  <IconUrl DefaultValue="https://rhysiboy-jpg.github.io/radphys-revise/icons/addin-32.png" />
  <HighResolutionIconUrl DefaultValue="https://rhysiboy-jpg.github.io/radphys-revise/icons/addin-64.png" />
  <SupportUrl DefaultValue="https://rhysiboy-jpg.github.io/radphys-revise/#about" />
  <AppDomains>
    <AppDomain>https://rhysiboy-jpg.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://rhysiboy-jpg.github.io/radphys-revise/addin/index.html" />
    <RequestedWidth>900</RequestedWidth>
    <RequestedHeight>500</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
